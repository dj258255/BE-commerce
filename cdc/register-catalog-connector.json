{
  "name": "catalog-cdc",
  "config": {
    "connector.class": "io.debezium.connector.mysql.MySqlConnector",
    "database.hostname": "mysql",
    "database.port": "3306",
    "database.user": "root",
    "database.password": "root",
    "database.server.id": "184055",
    "database.include.list": "becommerce",
    "table.include.list": "becommerce.products,becommerce.stock",
    "topic.prefix": "pay-cdc-catalog",
    "snapshot.mode": "no_data",
    "tombstones.on.delete": "false",
    "include.schema.changes": "false",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:29092",
    "schema.history.internal.kafka.topic": "pay-cdc-catalog.schema-history",
    "key.converter": "org.apache.kafka.connect.json.JsonConverter",
    "key.converter.schemas.enable": "false",
    "value.converter": "org.apache.kafka.connect.json.JsonConverter",
    "value.converter.schemas.enable": "false",
    "transforms": "unwrap,keyFromValue,keyField,route",
    "transforms.unwrap.type": "io.debezium.transforms.ExtractNewRecordState",
    "transforms.unwrap.drop.tombstones": "true",
    "transforms.unwrap.delete.handling.mode": "rewrite",
    "transforms.keyFromValue.type": "org.apache.kafka.connect.transforms.ValueToKey",
    "transforms.keyFromValue.fields": "product_id",
    "transforms.keyField.type": "org.apache.kafka.connect.transforms.ExtractField$Key",
    "transforms.keyField.field": "product_id",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": ".*",
    "transforms.route.replacement": "catalog.change",
    "poll.interval.ms": "100",
    "max.batch.size": "256",
    "max.queue.size": "1024"
  }
}
